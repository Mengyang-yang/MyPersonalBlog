    "@radix-ui/react-switch": "^1.3.7",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
